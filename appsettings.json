{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AzureAd": {
    "TenantId": "YOUR_TENANT_ID",
    "ClientId": "YOUR_CLIENT_ID",
    "ClientSecret": "YOUR_CLIENT_SECRET"
  },
  "Email": {
    "SharedMailboxAddress": "support@votre-domaine.com",
    "PollingIntervalMinutes": 5,
    "ServiceId": 2,
    "WorkingHours": {
      "Enabled": true,
      "StartHour": 8,
      "EndHour": 18,
      "TimeZone": "Romance Standard Time"
    }
  },
  "Claude": {
    "ApiKey": "YOUR_CLAUDE_API_KEY"
  },
  "Gemini": {
    "ApiKey": "YOUR_GEMINI_API_KEY"
  },
  "TicketingApi": {
    "BaseUrl": "YOUR_TICKETING_API_URL",
    "Token": "YOUR_TICKETING_API_TOKEN"
  },
  "Database": {
    "Path": "/app/data/emails.db"
  }
}
