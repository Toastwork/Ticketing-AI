# Azure AD / Entra ID Configuration
# Créer une App Registration dans Azure Portal : https://portal.azure.com/#view/Microsoft_AAD_IAM/ActiveDirectoryMenuBlade/~/RegisteredApps
AZURE_TENANT_ID=your-tenant-id-here
AZURE_CLIENT_ID=your-client-id-here
AZURE_CLIENT_SECRET=your-client-secret-here

# Email Configuration
# Une boite mail + un service_id par conteneur declare dans docker-compose.yml
POLLING_INTERVAL_MINUTES=5

# Conteneur "email-ticketing-service"
INFO_MAILBOX=support@votre-domaine.com
INFO_SERVICE_ID=2

# Conteneur "email-ticketing-zeendoc"
ZEENDOC_MAILBOX=support.zeendoc@votre-domaine.com
ZEENDOC_SERVICE_ID=3

# AI Provider Configuration
# Le système détecte automatiquement les clés API disponibles :
# - Si Gemini est fourni : utilise Gemini
# - Si Claude est fourni : utilise Claude
# - Si les deux sont fournis : priorité à Gemini avec fallback sur Claude

# Claude API Key
# Obtenir une clé API : https://console.anthropic.com/
CLAUDE_API_KEY=sk-ant-api03-your-claude-api-key-here

# Gemini API Key
# Obtenir une clé API : https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Ticketing API Configuration
TICKETING_API_URL=https://your-api-url.com/path/to/api/
TICKETING_API_TOKEN=Bearer your-bearer-token-here
